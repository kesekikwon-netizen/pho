package kr.archsurvey.map

/**
 * V월드 제품 기본값.
 * 내장 OpenAPI 키: 앱 시작 시 [kr.archsurvey.data.SettingsStore.ensureBuiltinMapKey] 가
 * 저장소가 비어 있으면 secure Pref 에 심는다(업데이트·암호화 Pref 초기화 후에도 유지).
 * [SettingsStore.mapKey] getter 도 blank 폴백. 사용자가 다른 키를 저장하면 그 값이 우선.
 * 화면·로그·토스트에는 키 원문을 넣지 않는다(끝 4자리만).
 */
object VWorldDefaults {
    /** 제품 기본 OpenAPI 키(사용자 오버라이드 가능) */
    const val BUILTIN_API_KEY = ""  // 템플릿: 실키는 git 밖에서 복사
    /**
     * 저장이 비었을 때 쓰는 도메인.
     * 지적 주 경로(레거시 2DCache)는 DOMAIN 을 쓰지 않음.
     * 공식 OpenAPI 폴백에서는 빈칸 → DOMAIN=DEFAULT 로 보냄(0.1.24).
     * 발급 때 특정 URL 을 넣었다면 그 URL 을 도메인 칸에 그대로.
     */
    const val BUILTIN_DOMAIN = ""

    /** UI용: 전체 키 없이 상태 + 끝 4자리 */
    fun keyStatusKo(key: String): String {
        val k = key.trim()
        if (k.isBlank()) return "아직 키가 없어요. V월드(vworld.kr) 오픈API에서 받은 인증키를 넣으세요."
        val last4 = k.takeLast(4)
        return if (k == BUILTIN_API_KEY) "내장 인증키 사용 중 · …$last4"
        else "저장 인증키 사용 중 · …$last4"
    }

    /**
     * 입력 칸이 비어 있을 때 보이는 마스킹 힌트(불릿 + 끝 4자리).
     * “키가 없는 것처럼” 보이지 않게 한다. 원문·전체 길이를 노출하지 않음.
     */
    fun maskedKeyPlaceholder(key: String): String {
        val k = key.trim()
        if (k.isBlank()) return ""
        return "••••••••••••" + k.takeLast(4)
    }
}
